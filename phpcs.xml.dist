<?xml version="1.0"?>
<ruleset name="GazelleBlocks">
    <description>Coding standards for Gazelle Blocks.</description>

    <file>./gazelle-blocks.php</file>
    <file>./includes</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>

    <!-- Allow PSR-4 class filenames (e.g. Plugin.php instead of class-plugin.php) -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>/includes/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="gazelle-blocks"/>
            </property>
        </properties>
    </rule>
</ruleset>